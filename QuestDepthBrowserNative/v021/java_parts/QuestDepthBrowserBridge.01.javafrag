                pointerOverlay.setPointer(x, y, true);
            }

            long now = SystemClock.uptimeMillis();
            try {
                if (action == MotionEvent.ACTION_HOVER_MOVE) {
                    MotionEvent hover = MotionEvent.obtain(
                            now,
                            now,
                            MotionEvent.ACTION_HOVER_MOVE,
                            x,
                            y,
                            0);
                    hover.setSource(InputDevice.SOURCE_MOUSE);
                    rootFrame.dispatchGenericMotionEvent(hover);
                    hover.recycle();
                    return;
                }

                if (action == MotionEvent.ACTION_DOWN) {
                    pointerDownTime = now;
                }
                long downTime = pointerDownTime != 0 ? pointerDownTime : now;
                MotionEvent touch = MotionEvent.obtain(
                        downTime,
                        now,
                        action,
                        x,
                        y,
                        0);
                touch.setSource(InputDevice.SOURCE_TOUCHSCREEN);
                rootFrame.dispatchTouchEvent(touch);
                touch.recycle();
                if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
                    pointerDownTime = 0;
                }
            } catch (Throwable ignored) {}
        });
    }

    public static void hidePointer() {
        MAIN.post(() -> {
            if (pointerOverlay != null) pointerOverlay.setPointer(0f, 0f, false);
        });
    }

    public static boolean handleHardwareKey(KeyEvent event) {
        if (presentation == null || event == null) return false;
        View target = currentInputTarget();
        if (target == null) return false;

        String mapped = germanTextFor(event);
        if (mapped != null) {
            if (event.getAction() == KeyEvent.ACTION_DOWN) {
                return commitText(target, mapped);
            }
            return true;
        }

        if (event.getKeyCode() == KeyEvent.KEYCODE_ENTER && target == addressBar) {
            if (event.getAction() == KeyEvent.ACTION_DOWN) navigate();
            return true;
        }

        try {
            return target.dispatchKeyEvent(event);
        } catch (Throwable ignored) {
            return false;
        }
    }

    public static void stop() {
        MAIN.post(QuestDepthBrowserBridge::stopInternal);
    }

    private static ViewGroup createBrowserUi(Activity activity) {
        final float density = activity.getResources().getDisplayMetrics().density;

        rootFrame = new FrameLayout(activity);
        rootFrame.setBackgroundColor(Color.rgb(12, 17, 22));

        LinearLayout browserRoot = new LinearLayout(activity);
        browserRoot.setOrientation(LinearLayout.VERTICAL);
        browserRoot.setBackgroundColor(Color.rgb(12, 17, 22));

        LinearLayout toolbar = new LinearLayout(activity);
        toolbar.setOrientation(LinearLayout.HORIZONTAL);
        toolbar.setGravity(Gravity.CENTER_VERTICAL);
        toolbar.setPadding(dp(8, density), dp(6, density), dp(8, density), dp(6, density));
        toolbar.setBackgroundColor(Color.rgb(45, 61, 78));

        Button back = button(activity, "◀");
        Button forward = button(activity, "▶");
        Button reload = button(activity, "↻");
        Button go = button(activity, "GO");
        TextView badge = new TextView(activity);
        badge.setText(" DEPTH v0.2.1  |  DE QWERTZ ");
        badge.setTextColor(Color.WHITE);
        badge.setTextSize(14f);
        badge.setGravity(Gravity.CENTER);
        badge.setBackgroundColor(Color.rgb(27, 122, 78));

