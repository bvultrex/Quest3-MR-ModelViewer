        "browser_stick",
        "Browser Thumbstick",
        2,
        handSubactionPaths);

    aimPoseAction = CreateAction(
'''
input_cpp = replace_once(input_cpp, create_actions_anchor, create_actions_replacement, 'browser action creation')

binding_anchor = '''        bindings.push_back(
            ActionSuggestedBinding(app, boolAction, "/user/hand/right/input/trigger"));
'''
binding_replacement = binding_anchor + '''        bindings.push_back(
            ActionSuggestedBinding(app, browserGripAction, "/user/hand/right/input/squeeze/value"));
        bindings.push_back(
            ActionSuggestedBinding(app, browserThumbstickAction, "/user/hand/right/input/thumbstick"));
'''
input_cpp = replace_once(input_cpp, binding_anchor, binding_replacement, 'browser action bindings')

sync_anchor = '    boolState = GetActionStateBoolean(app, boolAction);\n'
sync_replacement = sync_anchor + '''    rightGripState = GetActionStateFloat(app, browserGripAction, rightHandPath);
    rightThumbstickState = GetActionStateVector2f(app, browserThumbstickAction, rightHandPath);
'''
input_cpp = replace_once(input_cpp, sync_anchor, sync_replacement, 'browser action state sync')
input_cpp_path.write_text(input_cpp)

