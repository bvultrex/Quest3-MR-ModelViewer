    'XrActionStateBoolean boolState;\n'
    'XrActionStateFloat rightGripState{XR_TYPE_ACTION_STATE_FLOAT};\n'
    'XrActionStateVector2f rightThumbstickState{XR_TYPE_ACTION_STATE_VECTOR2F};\n',
    'browser input global states')

create_actions_anchor = '''    XrPath handSubactionPaths[2] = {leftHandPath, rightHandPath};

    aimPoseAction = CreateAction(
'''
create_actions_replacement = '''    XrPath handSubactionPaths[2] = {leftHandPath, rightHandPath};

    browserGripAction = CreateAction(
        runningActionSet,
        XR_ACTION_TYPE_FLOAT_INPUT,
        "browser_grip",
