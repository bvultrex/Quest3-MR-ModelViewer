activity = replace_once(
    activity,
    'import android.util.Log;\n',
    'import android.util.Log;\nimport android.view.KeyEvent;\n',
    'MainNativeActivity KeyEvent import')
activity = replace_once(
    activity,
    '''  @Override
  public void onDestroy() {
''',
    '''  @Override
  public boolean dispatchKeyEvent(KeyEvent event) {
    if (QuestDepthBrowserBridge.handleHardwareKey(event)) {
      return true;
    }
    return super.dispatchKeyEvent(event);
  }

  @Override
  public void onDestroy() {
''',
    'hardware keyboard forwarding')
activity_path.write_text(activity)

