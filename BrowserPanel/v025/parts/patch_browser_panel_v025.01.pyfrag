rep(
'''    private static int surfaceHeight;

    private QuestBrowserPanelBridge() {}
''',
'''    private static int surfaceHeight;
    private static float zoomScale = 1.0f;
    private static final String HOME_URL = "https://www.wikipedia.org/";
    private static final String PREFS_NAME = "quest_browser_panel";
    private static final String PREF_FAVORITES = "favorites";

    private QuestBrowserPanelBridge() {}

    private static native void nativeResetWindow();
''',
'comfort constants/native')

helpers = r'''
    private static SharedPreferences prefs() {
        if (hostActivity == null) return null;
        return hostActivity.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
    }

    private static LinkedHashSet<String> favorites() {
        LinkedHashSet<String> out = new LinkedHashSet<>();
        SharedPreferences prefs = prefs();
        if (prefs == null) return out;
        Set<String> saved = prefs.getStringSet(PREF_FAVORITES, null);
        if (saved != null) out.addAll(saved);
        return out;
    }

    private static void saveFavorites(LinkedHashSet<String> values) {
        SharedPreferences prefs = prefs();
        if (prefs == null) return;
        prefs.edit().putStringSet(PREF_FAVORITES, new LinkedHashSet<>(values)).apply();
    }

    private static String currentUrl() {
        if (webView == null) return "";
        String url = webView.getUrl();
        return url == null ? "" : url;
    }

    private static String favoriteLabel(String url) {
        try {
            Uri uri = Uri.parse(url);
            String host = uri.getHost();
            if (host == null || host.isEmpty()) return "LINK";
            if (host.startsWith("www.")) host = host.substring(4);
            return host.length() > 18 ? host.substring(0, 18) : host;
        } catch (Throwable ignored) {
            return "LINK";
        }
    }

    private static void refreshFavoriteState() {
        if (favoriteToggle == null) return;
        String url = currentUrl();
        favoriteToggle.setText(!url.isEmpty() && favorites().contains(url) ? "★" : "☆");
    }

    private static void refreshFavoritesBar() {
        if (favoritesBar == null) return;
        favoritesBar.removeAllViews();
        Context context = favoritesBar.getContext();
        int shown = 0;
        for (String url : favorites()) {
            if (shown >= 8) break;
            Button button = toolbarButton(context, favoriteLabel(url));
            button.setTextSize(13f);
            button.setOnClickListener(v -> {
                if (webView != null) webView.loadUrl(url);
            });
            LinearLayout.LayoutParams params =
                    new LinearLayout.LayoutParams(0, dp(context, 44), 1f);
            params.setMargins(dp(context, 2), dp(context, 2), dp(context, 2), dp(context, 2));
            favoritesBar.addView(button, params);
            shown++;
        }
        if (favoritesToggle != null) {
            favoritesToggle.setText(shown > 0 ? "FAV " + shown : "FAV");
        }
    }

    private static void toggleFavorite() {
        String url = currentUrl();
        if (url.isEmpty()) return;
        LinkedHashSet<String> values = favorites();
        if (values.contains(url)) {
            values.remove(url);
        } else {
            values.add(url);
            while (values.size() > 8) {
                String first = values.iterator().next();
                values.remove(first);
            }
        }
        saveFavorites(values);
        refreshFavoriteState();
        refreshFavoritesBar();
    }

    private static void goHome() {
        if (webView != null) webView.loadUrl(HOME_URL);
    }

    private static void adjustZoom(float factor) {
        if (webView == null) return;
        float target = Math.max(0.55f, Math.min(2.00f, zoomScale * factor));
        float actual = target / zoomScale;
        try {
            webView.zoomBy(actual);
            zoomScale = target;
        } catch (Throwable ignored) {}
    }

    private static void resetZoom() {
        if (webView == null) return;
        try {
            if (Math.abs(zoomScale - 1.0f) > 0.001f) {
                webView.zoomBy(1.0f / zoomScale);
            }
            zoomScale = 1.0f;
        } catch (Throwable ignored) {}
    }

'''
anchor = '    private static Button toolbarButton(Context context, String text) {'
if helpers.strip() not in j:
    if anchor not in j:
        raise SystemExit('BrowserPanel v0.2.5 helper insertion anchor missing')
