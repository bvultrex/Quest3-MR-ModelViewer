from pathlib import Path

CPP = Path('meta-openxr-sdk/Samples/XrSamples/XrPassthroughOcclusion/Src/XrPassthroughOcclusionGl.cpp')
text = CPP.read_text()

old = r'''        if (browserResizeHoverHand >= 0) {
            const Matrix4f resizeMarker =
                Matrix4f::Translation(
                    browserResizeHitWorld[0] + gQuestBrowserPanel.pose.M[0][2] * 0.004f,
                    browserResizeHitWorld[1] + gQuestBrowserPanel.pose.M[1][2] * 0.004f,
                    browserResizeHitWorld[2] + gQuestBrowserPanel.pose.M[2][2] * 0.004f) *
                Matrix4f::Scaling(0.010f, 0.010f, 0.0015f);
            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                1.0f));
            GL(glUniform3f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_COLOR),
                0.58f, 0.92f, 1.00f));
            GL(glUniformMatrix4fv(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::MODEL_MATRIX),
                1,
                GL_TRUE,
                &resizeMarker.M[0][0]));
            GL(glDrawElements(
                GL_TRIANGLES,
                scene.Box.GetIndexCount(),
                GL_UNSIGNED_SHORT,
                nullptr));
            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                0.0f));
        }
'''

new = r'''        if (browserResizeHoverHand >= 0 && browserResizeHoverCorner >= 0) {
            // Quest-style hover affordance: two bright bars form an L entirely
            // OUTSIDE the visible browser quad. Nothing overlays webpage pixels.
            const float sx =
                (browserResizeHoverCorner == 1 || browserResizeHoverCorner == 3) ? 1.0f : -1.0f;
            const float sy =
                (browserResizeHoverCorner == 2 || browserResizeHoverCorner == 3) ? 1.0f : -1.0f;
            const float halfW = gQuestBrowserPanel.widthMeters * 0.5f;
            const float halfH = gQuestBrowserPanel.heightMeters * 0.5f;
            const float pad = 0.020f;
            const float arm = 0.065f;
            const float thickness = 0.006f;

            const Matrix4f resizeHorizontal =
                gQuestBrowserPanel.pose *
                Matrix4f::Translation(
                    sx * (halfW + pad + arm * 0.5f),
                    sy * (halfH + pad),
                    0.012f) *
                Matrix4f::Scaling(arm * 0.5f, thickness, 0.0020f);
            const Matrix4f resizeVertical =
                gQuestBrowserPanel.pose *
                Matrix4f::Translation(
                    sx * (halfW + pad),
                    sy * (halfH + pad + arm * 0.5f),
                    0.012f) *
                Matrix4f::Scaling(thickness, arm * 0.5f, 0.0020f);

            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                1.0f));
            GL(glUniform3f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_COLOR),
                0.30f, 0.92f, 1.00f));

            GL(glUniformMatrix4fv(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::MODEL_MATRIX),
                1,
                GL_TRUE,
                &resizeHorizontal.M[0][0]));
            GL(glDrawElements(
                GL_TRIANGLES,
                scene.Box.GetIndexCount(),
                GL_UNSIGNED_SHORT,
                nullptr));

            GL(glUniformMatrix4fv(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::MODEL_MATRIX),
                1,
                GL_TRUE,
                &resizeVertical.M[0][0]));
            GL(glDrawElements(
                GL_TRIANGLES,
                scene.Box.GetIndexCount(),
                GL_UNSIGNED_SHORT,
                nullptr));

            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                0.0f));
        }
'''

if old not in text:
    raise SystemExit('BrowserPanel v0.2.1 resize hover marker anchor not found')
text = text.replace(old, new, 1)
CPP.write_text(text)

print('BrowserPanel v0.2.1 visible outer-corner L hover indicator: ON')
