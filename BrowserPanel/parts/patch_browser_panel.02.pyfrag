    gQuestBrowserPanel.initialized = true;
    gQuestBrowserPanel.placed = false;
    ALOGV("QuestBrowserPanel v0.1 initialized at %dx%d", QuestBrowserPanelState::kTextureWidth, QuestBrowserPanelState::kTextureHeight);
    return true;
}

extern "C" void QuestBrowserPanelUpdate(JNIEnv* env) {
    if (!gQuestBrowserPanel.initialized || env == nullptr ||
        gQuestBrowserPanel.surfaceTexture == nullptr) {
        return;
    }
    env->CallVoidMethod(gQuestBrowserPanel.surfaceTexture, gQuestBrowserPanel.updateTexImage);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
        return;
    }
    env->CallVoidMethod(
        gQuestBrowserPanel.surfaceTexture,
        gQuestBrowserPanel.getTransformMatrix,
        gQuestBrowserPanel.transformArray);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
        return;
    }
    env->GetFloatArrayRegion(
        gQuestBrowserPanel.transformArray,
        0,
        16,
        gQuestBrowserPanel.textureTransform);
}

extern "C" void QuestBrowserPanelDestroy(JNIEnv* env) {
    if (env != nullptr && gQuestBrowserPanel.bridgeClass != nullptr &&
        gQuestBrowserPanel.bridgeStop != nullptr) {
        env->CallStaticVoidMethod(gQuestBrowserPanel.bridgeClass, gQuestBrowserPanel.bridgeStop);
        if (env->ExceptionCheck()) env->ExceptionClear();
    }
    if (env != nullptr && gQuestBrowserPanel.surfaceTexture != nullptr &&
        gQuestBrowserPanel.releaseSurfaceTexture != nullptr) {
        env->CallVoidMethod(
            gQuestBrowserPanel.surfaceTexture,
            gQuestBrowserPanel.releaseSurfaceTexture);
        if (env->ExceptionCheck()) env->ExceptionClear();
    }
    if (gQuestBrowserPanel.vao != 0) GL(glDeleteVertexArrays(1, &gQuestBrowserPanel.vao));
    if (gQuestBrowserPanel.vbo != 0) GL(glDeleteBuffers(1, &gQuestBrowserPanel.vbo));
    if (gQuestBrowserPanel.ibo != 0) GL(glDeleteBuffers(1, &gQuestBrowserPanel.ibo));
    if (gQuestBrowserPanel.texture != 0) GL(glDeleteTextures(1, &gQuestBrowserPanel.texture));
    if (env != nullptr && gQuestBrowserPanel.transformArray != nullptr) {
        env->DeleteGlobalRef(gQuestBrowserPanel.transformArray);
    }
    if (env != nullptr && gQuestBrowserPanel.surfaceTexture != nullptr) {
        env->DeleteGlobalRef(gQuestBrowserPanel.surfaceTexture);
    }
    if (env != nullptr && gQuestBrowserPanel.bridgeClass != nullptr) {
        env->DeleteGlobalRef(gQuestBrowserPanel.bridgeClass);
    }
    gQuestBrowserPanel = QuestBrowserPanelState{};
}
