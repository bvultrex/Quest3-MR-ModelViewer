        vertices[i].uv[0] = uvs[i][0];
        vertices[i].uv[1] = uvs[i][1];
        vertices[i].color[0] = 255;
        vertices[i].color[1] = 255;
        vertices[i].color[2] = 255;
        vertices[i].color[3] = 255;
    }
    const uint32_t indices[6] = {0, 1, 2, 2, 1, 3};

    GL(glGenVertexArrays(1, &gQuestBrowserPanel.vao));
    GL(glBindVertexArray(gQuestBrowserPanel.vao));
    GL(glGenBuffers(1, &gQuestBrowserPanel.vbo));
    GL(glBindBuffer(GL_ARRAY_BUFFER, gQuestBrowserPanel.vbo));
    GL(glBufferData(GL_ARRAY_BUFFER, sizeof(vertices), vertices, GL_STATIC_DRAW));

    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_POSITION));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_POSITION,
        3,
        GL_FLOAT,
        GL_FALSE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, position))));
    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_COLOR));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_COLOR,
        4,
        GL_UNSIGNED_BYTE,
        GL_TRUE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, color))));
    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_UV));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_UV,
        2,
        GL_FLOAT,
        GL_FALSE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, uv))));
    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_NORMAL));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_NORMAL,
        3,
        GL_FLOAT,
        GL_FALSE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, normal))));

    GL(glGenBuffers(1, &gQuestBrowserPanel.ibo));
    GL(glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, gQuestBrowserPanel.ibo));
    GL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, sizeof(indices), indices, GL_STATIC_DRAW));
    GL(glBindVertexArray(0));
    gQuestBrowserPanel.indexCount = 6;
}

JNIEnv* QuestBrowserEnv() {
    if (gQuestBrowserPanel.vm == nullptr) {
        return nullptr;
    }
    JNIEnv* env = nullptr;
    if (gQuestBrowserPanel.vm->GetEnv(
            reinterpret_cast<void**>(&env), JNI_VERSION_1_6) != JNI_OK) {
        return nullptr;
    }
    return env;
}

void QuestBrowserSendPointer(float u, float v, int action) {
    JNIEnv* env = QuestBrowserEnv();
    if (env == nullptr || gQuestBrowserPanel.bridgeClass == nullptr ||
        gQuestBrowserPanel.bridgePointer == nullptr) {
        return;
    }
    env->CallStaticVoidMethod(
        gQuestBrowserPanel.bridgeClass,
        gQuestBrowserPanel.bridgePointer,
        u,
        v,
        action);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
    }
}

void QuestBrowserClick(float u, float v, int action) {
    JNIEnv* env = QuestBrowserEnv();
    if (env == nullptr || gQuestBrowserPanel.bridgeClass == nullptr ||
        gQuestBrowserPanel.bridgeClick == nullptr) {
        return;
    }
    env->CallStaticVoidMethod(
        gQuestBrowserPanel.bridgeClass,
        gQuestBrowserPanel.bridgeClick,
        u,
        v);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
    }
}
#endif
'''
    public_wrappers = r'''

#if defined(ANDROID)
extern "C" bool QuestBrowserPanelInitialize(JNIEnv* env, jobject activity) {
    if (gQuestBrowserPanel.initialized) {
        return true;
    }
    if (env == nullptr || activity == nullptr) {
        return false;
    }
    env->GetJavaVM(&gQuestBrowserPanel.vm);

    jclass bridgeLocal = QuestBrowserLoadBridgeClass(env, activity);
    if (bridgeLocal == nullptr) {
        ALOGE("QuestBrowserPanel: bridge class not found");
        return false;
    }
    gQuestBrowserPanel.bridgeClass = reinterpret_cast<jclass>(env->NewGlobalRef(bridgeLocal));
    env->DeleteLocalRef(bridgeLocal);
    if (gQuestBrowserPanel.bridgeClass == nullptr) {
        return false;
    }

    jmethodID start = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass,
        "start",
        "(Landroid/app/Activity;Landroid/graphics/SurfaceTexture;III)V");
    gQuestBrowserPanel.bridgePointer = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "pointer", "(FFI)V");
    gQuestBrowserPanel.bridgeClick = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "click", "(FF)V");
    gQuestBrowserPanel.bridgeStop = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "stop", "()V");
    if (start == nullptr || gQuestBrowserPanel.bridgePointer == nullptr ||
        gQuestBrowserPanel.bridgeClick == nullptr || gQuestBrowserPanel.bridgeStop == nullptr) {
        ALOGE("QuestBrowserPanel: bridge methods unavailable");
        return false;
    }

    GL(glGenTextures(1, &gQuestBrowserPanel.texture));
    GL(glBindTexture(GL_TEXTURE_EXTERNAL_OES, gQuestBrowserPanel.texture));
    GL(glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR));
    GL(glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR));
    GL(glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE));
    GL(glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE));
    GL(glBindTexture(GL_TEXTURE_EXTERNAL_OES, 0));

    jclass surfaceTextureClass = env->FindClass("android/graphics/SurfaceTexture");
    if (surfaceTextureClass == nullptr) {
        if (env->ExceptionCheck()) env->ExceptionClear();
        return false;
    }
    jmethodID ctor = env->GetMethodID(surfaceTextureClass, "<init>", "(I)V");
    jmethodID setDefaultBufferSize = env->GetMethodID(
        surfaceTextureClass, "setDefaultBufferSize", "(II)V");
    gQuestBrowserPanel.updateTexImage = env->GetMethodID(
        surfaceTextureClass, "updateTexImage", "()V");
    gQuestBrowserPanel.getTransformMatrix = env->GetMethodID(
        surfaceTextureClass, "getTransformMatrix", "([F)V");
    gQuestBrowserPanel.releaseSurfaceTexture = env->GetMethodID(
        surfaceTextureClass, "release", "()V");
    jobject localSurfaceTexture = ctor != nullptr
        ? env->NewObject(surfaceTextureClass, ctor, static_cast<jint>(gQuestBrowserPanel.texture))
        : nullptr;
    if (localSurfaceTexture == nullptr) {
        if (env->ExceptionCheck()) env->ExceptionClear();
        env->DeleteLocalRef(surfaceTextureClass);
        return false;
    }
    if (setDefaultBufferSize != nullptr) {
        env->CallVoidMethod(
            localSurfaceTexture,
            setDefaultBufferSize,
            QuestBrowserPanelState::kTextureWidth,
            QuestBrowserPanelState::kTextureHeight);
        if (env->ExceptionCheck()) env->ExceptionClear();
    }
    gQuestBrowserPanel.surfaceTexture = env->NewGlobalRef(localSurfaceTexture);
    env->DeleteLocalRef(localSurfaceTexture);
    env->DeleteLocalRef(surfaceTextureClass);

    jfloatArray localTransform = env->NewFloatArray(16);
    gQuestBrowserPanel.transformArray = reinterpret_cast<jfloatArray>(
        env->NewGlobalRef(localTransform));
    env->DeleteLocalRef(localTransform);

    QuestBrowserCreateMesh();
    env->CallStaticVoidMethod(
        gQuestBrowserPanel.bridgeClass,
        start,
        activity,
        gQuestBrowserPanel.surfaceTexture,
        QuestBrowserPanelState::kTextureWidth,
        QuestBrowserPanelState::kTextureHeight,
        QuestBrowserPanelState::kDensityDpi);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
        return false;
    }

