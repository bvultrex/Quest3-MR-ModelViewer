import android.text.TextWatcher;
''',
'text watcher imports')

rep(
'''    private static WebView webView;
    private static EditText addressBar;
    private static LinearLayout urlKeyboard;
    private static int surfaceWidth;
''',
'''    private static WebView webView;
    private static EditText addressBar;
    private static LinearLayout urlKeyboard;
    private static Activity hostActivity;
    private static EditText imeProxy;
    private static boolean syncingImeProxy;
    private static int imeProxyMode;
    private static final int IME_NONE = 0;
    private static final int IME_URL = 1;
    private static final int IME_WEB = 2;
    private static int surfaceWidth;
''',
'IME proxy fields')

rep(
'''            stopInternal();
            try {
                surfaceWidth = width;
