        rootFrame = null;
''',
'''        webView = null;
        addressBar = null;
        urlKeyboard = null;
        rootFrame = null;

        try {
            hideSystemKeyboard();
            if (imeProxy != null && imeProxy.getParent() instanceof ViewGroup) {
                ((ViewGroup) imeProxy.getParent()).removeView(imeProxy);
            }
        } catch (Throwable ignored) {}
        imeProxy = null;
        hostActivity = null;
        syncingImeProxy = false;
        imeProxyMode = IME_NONE;
''',
'IME proxy cleanup')

JAVA.write_text(j)

print('BrowserPanel v0.2.3 primary-Activity hidden IME proxy: ON')
print('BrowserPanel v0.2.3 URL bar -> Quest overlay keyboard proxy: ON')
print('BrowserPanel v0.2.3 focused HTML inputs -> Quest overlay keyboard proxy: ON')
print('BrowserPanel v0.2.3 numeric/email/url/tel/password input type routing: ON')
