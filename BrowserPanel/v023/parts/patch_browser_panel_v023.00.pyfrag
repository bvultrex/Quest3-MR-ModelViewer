from pathlib import Path

ROOT = Path('meta-openxr-sdk/Samples/XrSamples/XrPassthroughOcclusion')
JAVA = ROOT / 'java/com/oculus/xrpassthroughocclusion/QuestBrowserPanelBridge.java'

j = JAVA.read_text()

def rep(old, new, label):
    global j
    if old not in j:
        raise SystemExit(f'BrowserPanel v0.2.3 missing Java anchor: {label}')
    j = j.replace(old, new, 1)

rep(
'''import android.graphics.SurfaceTexture;
''',
