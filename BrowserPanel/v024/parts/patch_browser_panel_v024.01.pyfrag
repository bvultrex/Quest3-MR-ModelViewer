from pathlib import Path

ROOT = Path('meta-openxr-sdk/Samples/XrSamples/XrPassthroughOcclusion')
GL = ROOT / 'Src/XrPassthroughOcclusionGl.cpp'
JAVA = ROOT / 'java/com/oculus/xrpassthroughocclusion/QuestBrowserPanelBridge.java'

text = GL.read_text()

def rep(old, new, label):
    global text
    if old not in text:
        raise SystemExit(f'BrowserPanel v0.2.4 renderer anchor missing: {label}')
    text = text.replace(old, new, 1)

rep(
'''    jmethodID bridgePointer = nullptr;
    jmethodID bridgeClick = nullptr;
    jmethodID bridgeStop = nullptr;''',
'''    jmethodID bridgePointer = nullptr;
    jmethodID bridgeClick = nullptr;
    jmethodID bridgeScroll = nullptr;
    jmethodID bridgeStop = nullptr;''',
'scroll JNI field')

click_tail = '''void QuestBrowserClick(float u, float v) {
    JNIEnv* env = QuestBrowserEnv();
    if (env == nullptr || gQuestBrowserPanel.bridgeClass == nullptr ||
        gQuestBrowserPanel.bridgeClick == nullptr) {
        return;
    }
    env->CallStaticVoidMethod(
        gQuestBrowserPanel.bridgeClass,
        gQuestBrowserPanel.bridgeClick,
        u,
        v);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
    }
}
'''
scroll_func = click_tail + '''
void QuestBrowserScroll(float pixels) {
    JNIEnv* env = QuestBrowserEnv();
    if (env == nullptr || gQuestBrowserPanel.bridgeClass == nullptr ||
        gQuestBrowserPanel.bridgeScroll == nullptr) {
        return;
    }
    env->CallStaticVoidMethod(
        gQuestBrowserPanel.bridgeClass,
        gQuestBrowserPanel.bridgeScroll,
        pixels);
    if (env->ExceptionCheck()) {
        env->ExceptionClear();
    }
}
'''
if click_tail not in text:
    raise SystemExit('BrowserPanel v0.2.4 scroll function anchor missing')
text = text.replace(click_tail, scroll_func, 1)

rep(
'''    gQuestBrowserPanel.bridgeClick = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "click", "(FF)V");
    gQuestBrowserPanel.bridgeStop = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "stop", "()V");
    if (start == nullptr || gQuestBrowserPanel.bridgePointer == nullptr ||
        gQuestBrowserPanel.bridgeClick == nullptr || gQuestBrowserPanel.bridgeStop == nullptr) {''',
'''    gQuestBrowserPanel.bridgeClick = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "click", "(FF)V");
    gQuestBrowserPanel.bridgeScroll = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "scroll", "(F)V");
    gQuestBrowserPanel.bridgeStop = env->GetStaticMethodID(
        gQuestBrowserPanel.bridgeClass, "stop", "()V");
    if (start == nullptr || gQuestBrowserPanel.bridgePointer == nullptr ||
        gQuestBrowserPanel.bridgeClick == nullptr ||
        gQuestBrowserPanel.bridgeScroll == nullptr ||
        gQuestBrowserPanel.bridgeStop == nullptr) {''',
'scroll JNI lookup')

old_interaction = '''    if (browserPointerHand >= 0 && !gQuestBrowserPanel.resizing && !gQuestBrowserPanel.grabbed) {
        QuestBrowserSendPointer(
            browserPointerU,
            browserPointerV,
            AMOTION_EVENT_ACTION_HOVER_MOVE);
        const bool browserTriggerDown =
            QuestMrTriggerDownForHand(browserPointerHand);
        const bool browserTriggerPressed =
            browserTriggerDown && !uiTriggerPrev[browserPointerHand];
        if (browserTriggerPressed) {
            QuestBrowserClick(browserPointerU, browserPointerV);
        }
    }
'''

new_interaction = '''    // Precision stabilization for the controller aim ray. Small involuntary
    // motion is damped while deliberate larger movement stays responsive.
    static bool browserAimFilterValid[2] = {false, false};
    static float browserAimFilteredU[2] = {0.5f, 0.5f};
    static float browserAimFilteredV[2] = {0.5f, 0.5f};

    if (browserPointerHand >= 0 && !gQuestBrowserPanel.resizing && !gQuestBrowserPanel.grabbed) {
        const int aimHand = browserPointerHand;
        const float rawU = browserPointerU;
        const float rawV = browserPointerV;

        if (!browserAimFilterValid[aimHand]) {
            browserAimFilteredU[aimHand] = rawU;
            browserAimFilteredV[aimHand] = rawV;
            browserAimFilterValid[aimHand] = true;
        } else {
            const float du = rawU - browserAimFilteredU[aimHand];
            const float dv = rawV - browserAimFilteredV[aimHand];
            const float delta = std::sqrt(du * du + dv * dv);
            const float alpha =
                delta > 0.070f ? 0.78f :
                (delta > 0.025f ? 0.48f : 0.30f);
            browserAimFilteredU[aimHand] += du * alpha;
            browserAimFilteredV[aimHand] += dv * alpha;
        }

        browserPointerU = std::max(0.0f, std::min(1.0f, browserAimFilteredU[aimHand]));
        browserPointerV = std::max(0.0f, std::min(1.0f, browserAimFilteredV[aimHand]));

        // Rebuild the world-space reticle from the exact filtered UV so the
        // visible cursor and WebView click coordinates are guaranteed to match.
        const float filteredLocalX =
            (browserPointerU - 0.5f) * gQuestBrowserPanel.widthMeters;
        const float filteredLocalY =
            (0.5f - browserPointerV) * gQuestBrowserPanel.heightMeters;
        browserHitWorld[0] =
            gQuestBrowserPanel.pose.M[0][3] +
            gQuestBrowserPanel.pose.M[0][0] * filteredLocalX +
            gQuestBrowserPanel.pose.M[0][1] * filteredLocalY;
        browserHitWorld[1] =
            gQuestBrowserPanel.pose.M[1][3] +
            gQuestBrowserPanel.pose.M[1][0] * filteredLocalX +
            gQuestBrowserPanel.pose.M[1][1] * filteredLocalY;
        browserHitWorld[2] =
            gQuestBrowserPanel.pose.M[2][3] +
            gQuestBrowserPanel.pose.M[2][0] * filteredLocalX +
            gQuestBrowserPanel.pose.M[2][1] * filteredLocalY;

        QuestBrowserSendPointer(
            browserPointerU,
            browserPointerV,
            AMOTION_EVENT_ACTION_HOVER_MOVE);

        // Scroll with the thumbstick on the same controller that is currently
        // aiming at the browser. Deadzone + smoothstep gives fine low-speed
        // control but still allows fast page travel at full deflection.
        float stickX = 0.0f;
        float stickY = 0.0f;
        QuestMrThumbstickForHand(aimHand, &stickX, &stickY);
        constexpr float kScrollDeadzone = 0.18f;
        const float absScroll = std::abs(stickY);
        if (absScroll > kScrollDeadzone) {
            const float normalized =
                std::min(1.0f, (absScroll - kScrollDeadzone) / (1.0f - kScrollDeadzone));
            const float shaped = normalized * normalized * (3.0f - 2.0f * normalized);
            const float pixels =
                -std::copysign(26.0f * shaped, stickY);
            QuestBrowserScroll(pixels);
        }

        const bool browserTriggerDown =
            QuestMrTriggerDownForHand(browserPointerHand);
        const bool browserTriggerPressed =
            browserTriggerDown && !uiTriggerPrev[browserPointerHand];
        if (browserTriggerPressed) {
            QuestBrowserClick(browserPointerU, browserPointerV);
        }
    } else {
        for (int hand = 0; hand < 2; ++hand) {
            if (!handActive[hand]) {
                browserAimFilterValid[hand] = false;
            }
        }
    }
'''
rep(old_interaction, new_interaction, 'stabilized aim + scroll block')

# Smaller reticle communicates the actual click point more precisely.
rep(
'''                Matrix4f::Scaling(0.006f, 0.006f, 0.0015f);''',
'''                Matrix4f::Scaling(0.0045f, 0.0045f, 0.0015f);''',
'precision reticle size')

GL.write_text(text)

j = JAVA.read_text()
scroll_anchor = '''    public static void stop() {
        MAIN.post(QuestBrowserPanelBridge::stopInternal);
    }
'''
scroll_method = '''    public static void scroll(final float pixels) {
        MAIN.post(() -> {
            if (webView == null) return;
            try {
                webView.scrollBy(0, Math.round(pixels));
            } catch (Throwable ignored) {}
        });
    }

''' + scroll_anchor
if scroll_anchor not in j:
    raise SystemExit('BrowserPanel v0.2.4 Java scroll anchor missing')
j = j.replace(scroll_anchor, scroll_method, 1)
JAVA.write_text(j)

print('BrowserPanel v0.2.4 adaptive controller aim stabilization: ON')
print('BrowserPanel v0.2.4 reticle/click coordinates unified after filtering: ON')
print('BrowserPanel v0.2.4 pointing-hand thumbstick page scroll: ON')
