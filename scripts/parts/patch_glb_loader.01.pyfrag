                    v.color[c] = static_cast<unsigned char>(clamped * 255.0f + 0.5f);
                }
                vertices.push_back(v);
            }

            if (primitive.indices != nullptr) {
                for (cgltf_size index = 0; index < primitive.indices->count; ++index) {
                    indices.push_back(vertexBase + static_cast<uint32_t>(cgltf_accessor_read_index(primitive.indices, index)));
                }
            } else {
                for (cgltf_size index = 0; index < positionAccessor->count; ++index) {
                    indices.push_back(vertexBase + static_cast<uint32_t>(index));
                }
            }
        }
    }

    cgltf_free(data);

    if (vertices.empty() || indices.empty()) {
        ALOGE("QuestMR: GLB contains no triangle POSITION geometry");
        return false;
    }

    QuestMrDestroyImportedMesh();

    GL(glGenVertexArrays(1, &gQuestMrImportedMesh.vao));
    GL(glBindVertexArray(gQuestMrImportedMesh.vao));
    GL(glGenBuffers(1, &gQuestMrImportedMesh.vbo));
    GL(glBindBuffer(GL_ARRAY_BUFFER, gQuestMrImportedMesh.vbo));
    GL(glBufferData(
        GL_ARRAY_BUFFER,
        static_cast<GLsizeiptr>(vertices.size() * sizeof(QuestMrImportedVertex)),
        vertices.data(),
        GL_STATIC_DRAW));

    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_POSITION));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_POSITION,
        3,
        GL_FLOAT,
        GL_FALSE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, position))));
    GL(glEnableVertexAttribArray(VERTEX_ATTRIBUTE_LOCATION_COLOR));
    GL(glVertexAttribPointer(
        VERTEX_ATTRIBUTE_LOCATION_COLOR,
        4,
        GL_UNSIGNED_BYTE,
        GL_TRUE,
        sizeof(QuestMrImportedVertex),
        reinterpret_cast<const void*>(offsetof(QuestMrImportedVertex, color))));

    GL(glGenBuffers(1, &gQuestMrImportedMesh.ibo));
    GL(glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, gQuestMrImportedMesh.ibo));
    GL(glBufferData(
        GL_ELEMENT_ARRAY_BUFFER,
        static_cast<GLsizeiptr>(indices.size() * sizeof(uint32_t)),
        indices.data(),
        GL_STATIC_DRAW));
    GL(glBindVertexArray(0));

    gQuestMrImportedMesh.indexCount = static_cast<GLsizei>(indices.size());
    for (int axis = 0; axis < 3; ++axis) {
        gQuestMrImportedMesh.center[axis] = (minP[axis] + maxP[axis]) * 0.5f;
    }
    const float extentX = maxP[0] - minP[0];
    const float extentY = maxP[1] - minP[1];
    const float extentZ = maxP[2] - minP[2];
    const float maxExtent = std::max(extentX, std::max(extentY, extentZ));
    gQuestMrImportedMesh.fitScale = (maxExtent > 0.0001f) ? (0.34f / maxExtent) : 1.0f;
    gQuestMrImportedMesh.loadedStamp = stamp;
    gQuestMrImportedMesh.loaded = true;
    ALOGV(
        "QuestMR: imported GLB vertices=%zu indices=%zu fitScale=%f",
        vertices.size(),
        indices.size(),
        gQuestMrImportedMesh.fitScale);
    return true;
}

bool QuestMrPollImportFile(bool& changed) {
    changed = false;
    const std::string path = QuestMrImportPath();
    if (path.empty()) {
        return false;
    }
    struct stat st{};
    if (stat(path.c_str(), &st) != 0 || st.st_size <= 0) {
        return false;
    }
    const long long stamp = (static_cast<long long>(st.st_mtime) << 32) ^ static_cast<long long>(st.st_size);
    if (stamp == gQuestMrImportedMesh.loadedStamp) {
        return gQuestMrImportedMesh.loaded;
    }
    changed = true;
    const bool ok = QuestMrLoadGlb(path, stamp);
    if (!ok) {
        gQuestMrImportedMesh.loadedStamp = stamp;
    }
    gQuestMrImportState = ok ? 2 : 3;
    return ok;
}

} // namespace

'''
if 'QuestMrImportedMesh' not in text:
    text = text.replace(helper_anchor, helpers + '\n' + helper_anchor, 1)

# Clean imported GL resources with the scene.
if 'QuestMrDestroyImportedMesh();' not in text.split('void Scene::Destroy()', 1)[-1].split('}', 1)[0]:
    text = text.replace('    Box.Destroy();\n\n    CreatedScene = false;', '    Box.Destroy();\n    QuestMrDestroyImportedMesh();\n\n    CreatedScene = false;', 1)

block_re = re.compile(
    r'    // Quest3 MR Model Viewer v0\.2\.0 lighting lab\..*?    GL\(glBindVertexArray\(0\)\);',
    re.S,
)

replacement = r'''    // Quest3 MR Model Viewer v0.3.3: sticky lighting panel + GLB import.
    static float lightSliders[6] = {0.26f, 0.45f, 0.58f, 0.55f, 0.50f, 0.50f};
    static const float defaultLightSliders[6] = {0.26f, 0.45f, 0.58f, 0.55f, 0.50f, 0.50f};
    static bool panelInitialized = false;
    static bool panelPinned = false;
    static Matrix4f panelPose;
    static bool pinTouchPrev = false;
    static bool importTouchPrev = false;
    static Matrix4f importedModelRoot;
    static bool importedModelPlaced = false;

    constexpr float kSliderHalfWidth = 0.080f;
    constexpr float kSliderTopY = 0.085f;
    constexpr float kSliderStep = 0.035f;
    constexpr float kPanelFollowDistance = -0.32f;

    Matrix4f pointerTipMatrix;
    const bool haveLightingPalette = scene.TrackedControllers.size() >= 2;
    if (haveLightingPalette) {
        const Matrix4f anchorControllerPose(scene.TrackedControllers[0].Pose);
        const Matrix4f pointerPose(scene.TrackedControllers[1].Pose);
        pointerTipMatrix = pointerPose * Matrix4f::Translation(0.0f, 0.0f, -0.080f);

        if (!panelInitialized || !panelPinned) {
            panelPose = anchorControllerPose * Matrix4f::Translation(0.0f, 0.0f, kPanelFollowDistance);
            panelInitialized = true;
        }

        const float dx = pointerTipMatrix.M[0][3] - panelPose.M[0][3];
        const float dy = pointerTipMatrix.M[1][3] - panelPose.M[1][3];
        const float dz = pointerTipMatrix.M[2][3] - panelPose.M[2][3];
        const float localX =
            panelPose.M[0][0] * dx + panelPose.M[1][0] * dy + panelPose.M[2][0] * dz;
        const float localY =
            panelPose.M[0][1] * dx + panelPose.M[1][1] * dy + panelPose.M[2][1] * dz;
        const float localZ =
            panelPose.M[0][2] * dx + panelPose.M[1][2] * dy + panelPose.M[2][2] * dz;

        if (std::abs(localZ) < 0.055f) {
            for (int i = 0; i < 6; ++i) {
                const float rowY = kSliderTopY - float(i) * kSliderStep;
                if (std::abs(localY - rowY) < 0.016f &&
                    localX >= -kSliderHalfWidth - 0.012f &&
                    localX <= kSliderHalfWidth + 0.012f) {
                    lightSliders[i] = std::max(
                        0.0f,
                        std::min(
                            1.0f,
                            (localX + kSliderHalfWidth) / (2.0f * kSliderHalfWidth)));
                }
            }

            const float resetY = kSliderTopY - 6.0f * kSliderStep - 0.012f;
            if (std::abs(localX) < 0.025f && std::abs(localY - resetY) < 0.018f) {
                for (int i = 0; i < 6; ++i) {
                    lightSliders[i] = defaultLightSliders[i];
                }
            }

            const bool pinTouchNow =
                std::abs(localX + 0.050f) < 0.032f && std::abs(localY - 0.145f) < 0.020f;
            if (pinTouchNow && !pinTouchPrev) {
                panelPinned = !panelPinned;
            }
            pinTouchPrev = pinTouchNow;

            const bool importTouchNow =
                std::abs(localX - 0.050f) < 0.032f && std::abs(localY - 0.145f) < 0.020f;
            if (importTouchNow && !importTouchPrev) {
                gQuestMrImportState = QuestMrLaunchGlbPicker() ? 1 : 3;
            }
            importTouchPrev = importTouchNow;
        } else {
            pinTouchPrev = false;
            importTouchPrev = false;
        }
    }

    bool importChanged = false;
    const bool modelLoaded = QuestMrPollImportFile(importChanged);
    if (modelLoaded && (importChanged || !importedModelPlaced)) {
        if (scene.TrackedControllers.size() >= 2) {
            const Matrix4f pointerPose(scene.TrackedControllers[1].Pose);
            importedModelRoot = pointerPose * Matrix4f::Translation(0.0f, 0.0f, -0.70f);
            importedModelPlaced = true;
        } else if (!scene.TrackedControllers.empty()) {
            const Matrix4f controllerPose(scene.TrackedControllers[0].Pose);
            importedModelRoot = controllerPose * Matrix4f::Translation(0.0f, 0.0f, -0.70f);
            importedModelPlaced = true;
        }
    }

    const float ambientStrength = 0.02f + lightSliders[0] * 0.78f;
    const float keyIntensity = lightSliders[1] * 2.0f;
    const float azimuth = (lightSliders[2] * 2.0f - 1.0f) * 3.14159265f;
    const float elevation = -0.34906585f + lightSliders[3] * 1.74532925f;
    const float warmth = lightSliders[4] * 2.0f - 1.0f;
    const float exposureStops = -2.0f + lightSliders[5] * 4.0f;

    const float cosElevation = std::cos(elevation);
    const float lightDirection[3] = {
        cosElevation * std::cos(azimuth),
        std::sin(elevation),
