                GL(glUniform3f(
                    scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_COLOR),
                    selected ? 1.0f : 0.15f,
                    selected ? 0.78f : 0.75f,
                    selected ? 0.15f : 0.95f));
                GL(glUniformMatrix4fv(
                    scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::MODEL_MATRIX),
                    1,
                    GL_TRUE,
                    &jointModel.M[0][0]));
                GL(glDrawElements(GL_TRIANGLES, scene.Box.GetIndexCount(), GL_UNSIGNED_SHORT, NULL));
            }
            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                0.0f));
        }'''
marker_new = '''                const bool selected = joint == gQuestMrPoseJoint;
                const float marker = (selected ? 0.028f : 0.016f) / roomScale;
                const Matrix4f jointModel = importedModel *
                    Matrix4f::Translation(world[12], world[13], world[14]) *
                    Matrix4f::Scaling(marker, marker, marker);
                drawMarker(
                    jointModel,
                    selected ? 1.0f : 0.15f,
                    selected ? 0.82f : 0.90f,
                    selected ? 0.15f : 1.0f);
            }
            GL(glUniform1f(
                scene.BoxDepthSpaceOcclusionProgram.GetUniformLocationOrDie(Uniform::Index::UI_MODE),
                0.0f));
            GL(glEnable(GL_DEPTH_TEST));
        }'''
if marker_old not in text:
    raise SystemExit('v1.3.1 marker size anchor missing')
text = text.replace(marker_old, marker_new, 1)

cpp.write_text(text)
print('v1.3.1 overlay skeleton: ON')
print('v1.3.1 hand-handle joint swing: ON')
