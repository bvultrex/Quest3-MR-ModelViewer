from pathlib import Path
cpp = Path('meta-openxr-sdk/Samples/XrSamples/XrPassthroughOcclusion/Src/XrPassthroughOcclusionGl.cpp')
text=cpp.read_text()

# 1) imported mesh memory estimate + scene object storage + generation
old='''    std::vector<QuestMrImportedMaterial> materials;\n    std::vector<QuestMrImportedDraw> draws;\n    bool loaded = false;\n};\n\nQuestMrImportedMesh gQuestMrImportedMesh;\nint gQuestMrImportState = 0; // 0 idle, 1 picker/waiting, 2 loaded, 3 error\n'''
new='''    std::vector<QuestMrImportedMaterial> materials;\n    std::vector<QuestMrImportedDraw> draws;\n    uint64_t estimatedGpuBytes = 0;\n    bool loaded = false;\n};\n\nstruct QuestMrSceneObject {\n    QuestMrImportedMesh mesh;\n    Matrix4f root;\n    Matrix4f defaultRoot;\n    std::vector<float> jointPalette;\n    float scaleSlider = 0.0769231f;\n    float rotateSlider = 0.5f;\n    int physicalSizePreset = 0;\n    bool rigged = false;\n};\n\nconstexpr size_t kQuestMrMaxSceneModels = 6;\nconstexpr uint64_t kQuestMrSceneGpuBudgetBytes = 768ULL * 1024ULL * 1024ULL;\nstd::vector<QuestMrSceneObject> gQuestMrSceneObjects;\nuint64_t gQuestMrSceneGeneration = 0;\n\nQuestMrImportedMesh gQuestMrImportedMesh;\nint gQuestMrImportState = 0; // 0 idle, 1 picker/waiting, 2 loaded, 3 error\n'''
assert old in text
text=text.replace(old,new,1)

# 2) helpers after destroy imported
anchor='''    gQuestMrImportedMesh = QuestMrImportedMesh{};\n    gQuestMrImportedMesh.loadedStamp = stamp;\n}\n\nstd::string QuestMrImportPath() {\n'''
insert='''    gQuestMrImportedMesh = QuestMrImportedMesh{};\n    gQuestMrImportedMesh.loadedStamp = stamp;\n}\n\nvoid QuestMrDestroySceneObject(QuestMrSceneObject& object) {\n    if (object.mesh.vao != 0) { GL(glDeleteVertexArrays(1, &object.mesh.vao)); }\n    if (object.mesh.vbo != 0) { GL(glDeleteBuffers(1, &object.mesh.vbo)); }\n    if (object.mesh.ibo != 0) { GL(glDeleteBuffers(1, &object.mesh.ibo)); }\n    std::vector<GLuint> textures;\n    const GLuint legacy[3] = {\n        object.mesh.baseColorTexture, object.mesh.normalTexture, object.mesh.metallicRoughnessTexture};\n    for (GLuint name : legacy) {\n        if (name != 0 && std::find(textures.begin(), textures.end(), name) == textures.end()) {\n            textures.push_back(name);\n        }\n    }\n    for (const QuestMrImportedMaterial& material : object.mesh.materials) {\n        const GLuint names[3] = {\n            material.baseColorTexture, material.normalTexture, material.metallicRoughnessTexture};\n        for (GLuint name : names) {\n            if (name != 0 && std::find(textures.begin(), textures.end(), name) == textures.end()) {\n                textures.push_back(name);\n            }\n        }\n    }\n    for (GLuint name : textures) { GL(glDeleteTextures(1, &name)); }\n    object = QuestMrSceneObject{};\n}\n\nvoid QuestMrClearSceneObjects(bool destroyGlResources) {\n    if (destroyGlResources) {\n        for (QuestMrSceneObject& object : gQuestMrSceneObjects) {\n            QuestMrDestroySceneObject(object);\n        }\n    }\n    gQuestMrSceneObjects.clear();\n}\n\nbool QuestMrArchiveActiveModel(\n    const Matrix4f& root,\n    const Matrix4f& defaultRoot,\n    float scaleSlider,\n    float rotateSlider,\n    int physicalSizePreset) {\n    if (!gQuestMrImportedMesh.loaded) {\n        return true;\n    }\n    // Leave one slot free for the model that is about to be imported.\n    if (gQuestMrSceneObjects.size() >= kQuestMrMaxSceneModels - 1) {\n        ALOGE("QuestMR: scene model limit reached (%zu)", kQuestMrMaxSceneModels);\n        return false;\n    }\n    QuestMrSceneObject object;\n    object.mesh = std::move(gQuestMrImportedMesh);\n    object.root = root;\n    object.defaultRoot = defaultRoot;\n    object.jointPalette = gQuestMrJointPalette;\n    object.scaleSlider = scaleSlider;\n    object.rotateSlider = rotateSlider;\n    object.physicalSizePreset = physicalSizePreset;\n    object.rigged = gQuestMrLastImportRigged;\n    gQuestMrSceneObjects.push_back(std::move(object));\n\n    const long long stamp = gQuestMrSceneObjects.back().mesh.loadedStamp;\n    gQuestMrImportedMesh = QuestMrImportedMesh{};\n    gQuestMrImportedMesh.loadedStamp = stamp;\n    // Cache keys point into the cgltf document and are only meaningful during one import.\n    // The archived mesh materials own the GL texture names needed for rendering.\n    gQuestMrTextureCache.clear();\n    gQuestMrJointPalette.clear();\n    gQuestMrJoints.clear();\n    gQuestMrAnimChannels.clear();\n    gQuestMrAnimDuration = 0.0f;\n    gQuestMrAnimTime = 0.0f;\n    gQuestMrAnimPlaying = false;\n    gQuestMrPoseJoint = -1;\n    gQuestMrPoseActive = false;\n    gQuestMrPoseTwoBone = false;\n    gQuestMrLastImportRigged = false;\n    ALOGV("QuestMR v1.5.0 archived scene model count=%zu", gQuestMrSceneObjects.size());\n    return true;\n}\n\nstd::string QuestMrImportPath() {\n'''
assert anchor in text
text=text.replace(anchor,insert,1)

# 3) aggregate scene GPU budget after existing per-model estimate check
old='''    if (estimatedGpuBytes > kMaxEstimatedGpuBytes ||\n        estimatedCpuImportBytes > kMaxEstimatedCpuImportBytes) {\n        ALOGE(\n            "QuestMR: preflight rejected memory estimate cpu=%llu gpu=%llu",\n            static_cast<unsigned long long>(estimatedCpuImportBytes),\n            static_cast<unsigned long long>(estimatedGpuBytes));\n        cgltf_free(data);\n        return false;\n    }\n\n    ALOGV(\n'''
new='''    if (estimatedGpuBytes > kMaxEstimatedGpuBytes ||\n        estimatedCpuImportBytes > kMaxEstimatedCpuImportBytes) {\n        ALOGE(\n            "QuestMR: preflight rejected memory estimate cpu=%llu gpu=%llu",\n            static_cast<unsigned long long>(estimatedCpuImportBytes),\n            static_cast<unsigned long long>(estimatedGpuBytes));\n        cgltf_free(data);\n        return false;\n    }\n    uint64_t sceneGpuBytes = 0;\n    for (const QuestMrSceneObject& object : gQuestMrSceneObjects) {\n        sceneGpuBytes += object.mesh.estimatedGpuBytes;\n    }\n    if (sceneGpuBytes > kQuestMrSceneGpuBudgetBytes ||\n        estimatedGpuBytes > kQuestMrSceneGpuBudgetBytes - sceneGpuBytes) {\n        ALOGE(\n            "QuestMR: scene GPU budget rejected resident=%lluMiB incoming=%lluMiB cap=%lluMiB",\n            static_cast<unsigned long long>(sceneGpuBytes / (1024ULL * 1024ULL)),\n            static_cast<unsigned long long>(estimatedGpuBytes / (1024ULL * 1024ULL)),\n            static_cast<unsigned long long>(kQuestMrSceneGpuBudgetBytes / (1024ULL * 1024ULL)));\n        cgltf_free(data);\n        return false;\n    }\n\n    ALOGV(\n'''
assert old in text
text=text.replace(old,new,1)

# 4) save estimate on mesh
old='''    gQuestMrImportedMesh.materials = importedMaterials;\n    gQuestMrImportedMesh.draws = drawRanges;\n    gQuestMrImportedMesh.loadedStamp = stamp;\n'''
new='''    gQuestMrImportedMesh.materials = importedMaterials;\n    gQuestMrImportedMesh.draws = drawRanges;\n    gQuestMrImportedMesh.estimatedGpuBytes = estimatedGpuBytes;\n    gQuestMrImportedMesh.loadedStamp = stamp;\n'''
assert old in text
text=text.replace(old,new,1)

# 5) scene lifecycle reset generation + archived resources
old='''void Scene::Create() {\n    // v1.0.1: never trust static GL object names across an EGL/scene restart.\n    QuestMrInvalidateAllUiTextMeshes();\n'''
new='''void Scene::Create() {\n    // v1.5.0: every Scene/EGL recreation starts a fresh interaction epoch.\n    // CPU-local grab latches are reset in RenderFrame when this generation changes.\n    ++gQuestMrSceneGeneration;\n    QuestMrClearSceneObjects(false);\n    // v1.0.1: never trust static GL object names across an EGL/scene restart.\n    QuestMrInvalidateAllUiTextMeshes();\n'''
assert old in text
text=text.replace(old,new,1)
old='''void Scene::Destroy() {\n    GL(glDeleteBuffers(1, &SceneMatrices));\n    QuestMrDestroyAllUiTextMeshes();\n    QuestMrDestroyImportedMesh();\n'''
new='''void Scene::Destroy() {\n    GL(glDeleteBuffers(1, &SceneMatrices));\n    QuestMrDestroyAllUiTextMeshes();\n    QuestMrClearSceneObjects(true);\n    QuestMrDestroyImportedMesh();\n'''
assert old in text
text=text.replace(old,new,1)

# 6) render local state additions + hard reset on scene generation
old='''    static bool modelGrabbed = false;\n    static int modelGrabHand = -1;\n    static bool skeletonVisible = true;\n'''