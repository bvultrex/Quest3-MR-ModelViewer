                    const float upperX = gQuestMrPoseMidStart[0] - gQuestMrPoseRootStart[0];
                    const float upperY = gQuestMrPoseMidStart[1] - gQuestMrPoseRootStart[1];
                    const float upperZ = gQuestMrPoseMidStart[2] - gQuestMrPoseRootStart[2];
                    const float lowerX = gQuestMrPoseEndStart[0] - gQuestMrPoseMidStart[0];
                    const float lowerY = gQuestMrPoseEndStart[1] - gQuestMrPoseMidStart[1];
                    const float lowerZ = gQuestMrPoseEndStart[2] - gQuestMrPoseMidStart[2];
                    gQuestMrPoseLen1 = std::sqrt(upperX * upperX + upperY * upperY + upperZ * upperZ);
                    gQuestMrPoseLen2 = std::sqrt(lowerX * lowerX + lowerY * lowerY + lowerZ * lowerZ);
                    float axisX = gQuestMrPoseEndStart[0] - gQuestMrPoseRootStart[0];
