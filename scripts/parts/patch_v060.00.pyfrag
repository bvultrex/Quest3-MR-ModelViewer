                    gQuestMrPoseMidStart[1] = midWorld[13];
                    gQuestMrPoseMidStart[2] = midWorld[14];
                    gQuestMrPoseEndStart[0] = endWorld[12];
                    gQuestMrPoseEndStart[1] = endWorld[13];
