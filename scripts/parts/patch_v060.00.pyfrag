from pathlib import Path

cpp = Path('meta-openxr-sdk/Samples/XrSamples/XrPassthroughOcclusion/Src/XrPassthroughOcclusionGl.cpp')
text = cpp.read_text()

# v1.4.0: two-bone IK for hands and feet, plus a PLAY button for the GLB clip.
# Grabbing a knee or elbow still swings the parent bone rigidly.

